{
  "expo": {
    "name": "GriotX",
    "slug": "griot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "griotx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hamzamare.griotx"
    },
    "android": {
      "package": "com.hamzamare.griotx",
      "adaptiveIcon": {
        "backgroundColor": "#05070C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/griotx-splash-emblem.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#05070C",
          "dark": {
            "image": "./assets/branding/griotx-splash-emblem.png",
            "backgroundColor": "#05070C"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "fr"]
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
